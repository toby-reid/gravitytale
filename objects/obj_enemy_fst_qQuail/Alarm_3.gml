/// @description Confound
if !spare {
	obj_battleCore.text[1] = "You try to tell Question Quail #a paradox, but it is reminded #of its cousin, the Parrot-Ox."
	obj_battleCore.text[0] = "Question Quail misses home.&It no longer wants to fight."
	spare = true
}
else obj_battleCore.text[1] = "Question Quail cannot be #confounded."