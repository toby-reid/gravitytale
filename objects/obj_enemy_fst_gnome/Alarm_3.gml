/// @description Queen
if global.player[player.mabel] obj_battleCore.text[1] = "Before you can finish what you were #saying, Gnome falls to its knee #and proposes."
else obj_battleCore.text[1] = "You were about to offer your #sister's hand, but seeing Gnome #like this, you put it back."
obj_battleCore.text[0] = "You don't like to judge, but #Gnome is definitely not a good #marriage candidate."